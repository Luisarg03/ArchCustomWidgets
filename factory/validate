#!/usr/bin/env bash
# Validate ArchCustomWidgets units against the manifest contract.
# Usage: factory/validate [unit-dir]
#   With a unit-dir: validate that single unit.
#   With no args: validate every unit dir under widgets/ and services/.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Validate one unit dir. Returns non-zero on any failed check.
validate_unit() {
    local unit="$1"
    local manifest="$unit/manifest.json"
    local -i failures=0

    echo "== validating $unit"

    if [[ ! -f "$manifest" ]]; then
        echo "  FAIL: $manifest missing"
        return 1
    fi

    # One stdlib-only pass: required keys and types. On success prints
    # "id type entrypoint" for the filesystem checks below.
    local meta
    if ! meta="$(python3 - "$manifest" 2>&1 <<'PYEOF'
import json, sys

REQUIRED = ("id", "type", "description", "stack", "entrypoint")
try:
    with open(sys.argv[1]) as f:
        m = json.load(f)
except (OSError, json.JSONDecodeError) as e:
    sys.exit(f"manifest.json does not parse: {e}")
if not isinstance(m, dict):
    sys.exit("manifest.json root is not an object")
missing = [k for k in REQUIRED if not m.get(k)]
if missing:
    sys.exit("manifest.json missing or empty key(s): " + ", ".join(missing))
if m["type"] not in ("widget", "service"):
    sys.exit(f"type {m['type']!r} not in {{widget, service}}")
deps = m.get("deps", [])
if not isinstance(deps, list) or not all(isinstance(d, str) for d in deps):
    sys.exit("deps must be a list of strings")
print(m["id"], m["type"], m["entrypoint"])
PYEOF
    )"; then
        echo "  FAIL: $meta"
        echo "  FAIL: unit $unit has an invalid manifest.json"
        return 1
    fi
    echo "  OK: manifest.json has the required keys"

    local id type entrypoint
    read -r id type entrypoint <<<"$meta"

    if [[ ! -d "$unit/src" ]]; then
        echo "  FAIL: $unit/src directory missing"
        ((failures += 1)) || true
    fi

    if [[ ! -f "$unit/$entrypoint" ]]; then
        echo "  FAIL: entrypoint '$entrypoint' not found under $unit"
        ((failures += 1)) || true
    fi

    if [[ ! -f "$unit/install.sh" ]]; then
        echo "  FAIL: $unit/install.sh missing"
        ((failures += 1)) || true
    elif ! bash -n "$unit/install.sh" 2>/dev/null; then
        echo "  FAIL: $unit/install.sh fails bash -n"
        ((failures += 1)) || true
    fi

    if [[ ! -f "$unit/README.md" ]]; then
        echo "  FAIL: $unit/README.md missing"
        ((failures += 1)) || true
    fi

    local script
    while IFS= read -r -d '' script; do
        if ! bash -n "$script" 2>/dev/null; then
            echo "  FAIL: $script fails bash -n"
            ((failures += 1)) || true
        fi
    done < <(find "$unit" -name '*.sh' -type f -print0)

    if (( failures == 0 )); then
        echo "  PASS: unit $id ($type)"
        return 0
    fi
    echo "  FAIL: unit $id has $failures failed check(s)"
    return 1
}

# Validate one unit given on argv, or scan widgets/ + services/.
if (($# == 1)); then
    unit="$1"
    if [[ ! -d "$unit" ]]; then
        echo "error: no such unit directory: $unit" >&2
        exit 1
    fi
    if [[ ! -f "$unit/manifest.json" ]]; then
        echo "error: $unit/manifest.json missing; not a unit" >&2
        exit 1
    fi
    validate_unit "$unit"
    exit 0
elif (($# > 1)); then
    echo "usage: factory/validate [unit-dir]" >&2
    exit 1
fi

count=0
failed=0
for root in "$REPO_ROOT"/widgets "$REPO_ROOT"/services; do
    [[ -d "$root" ]] || continue
    for unit in "$root"/*; do
        [[ -d "$unit" && -f "$unit/manifest.json" ]] || continue
        ((count += 1)) || true
        validate_unit "$unit" || ((failed += 1)) || true
    done
done

if (( count == 0 )); then
    echo "no unit dirs found under widgets/ or services/; nothing to validate"
    exit 0
fi
echo "validated $count unit(s), $failed failed"
(( failed == 0 ))

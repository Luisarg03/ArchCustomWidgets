#!/usr/bin/env bash
# Wallhaven wallpaper fetcher for Caelestia (Hyprland).
#
#   wallhaven-wallpaper new    download a random matching wallpaper and apply it
#   wallhaven-wallpaper help   usage and the environment filters
#
# Filters come from the environment; nothing is read from or written to disk
# except the downloaded image.
set -euo pipefail

WALL_DIR="${WALL_DIR:-$HOME/Pictures/wallpapers}"
WALLHAVEN_DIR="$WALL_DIR/wallhaven"

API_BASE="https://wallhaven.cc/api/v1/search"
QUERY="${WALLHAVEN_QUERY:-}"
API_KEY="${WALLHAVEN_API_KEY:-}"
RESOLUTION="${WALLHAVEN_RESOLUTION:-2560x1440}"
RATIOS="${WALLHAVEN_RATIOS:-16x9}"
SORTING="${WALLHAVEN_SORTING:-random}"
TOPRANGE="${WALLHAVEN_TOPRANGE:-1M}"
PURITY="${WALLHAVEN_PURITY:-100}"
CATEGORIES="${WALLHAVEN_CATEGORIES:-111}"

die() {
    echo "Error: $*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: wallhaven-wallpaper <command>

Commands:
  new     Download a new random wallpaper from Wallhaven and apply it
  help    Show this help

Environment (set them in the keybind or export them):
  WALL_DIR              Base wallpaper directory (default: ~/Pictures/wallpapers)
  WALLHAVEN_QUERY       Search terms (e.g. "cyberpunk", "nature")
  WALLHAVEN_API_KEY     wallhaven.cc API key (required for NSFW purity)
  WALLHAVEN_RESOLUTION  Minimum resolution (default: 2560x1440)
  WALLHAVEN_RATIOS      Aspect ratio (default: 16x9)
  WALLHAVEN_SORTING     random, date_added, relevance, views, favorites, toplist
  WALLHAVEN_TOPRANGE    For sorting=toplist: 1d, 3d, 1w, 1M, 3M, 6M, 1y
  WALLHAVEN_PURITY      100=SFW, 110=sketchy, 111=NSFW (needs API key)
  WALLHAVEN_CATEGORIES  Three digits: General, Anime, People (111=all, 100=General)

Examples:
  WALLHAVEN_QUERY=cyberpunk wallhaven-wallpaper new
  WALLHAVEN_SORTING=toplist WALLHAVEN_TOPRANGE=1w wallhaven-wallpaper new
EOF
}

# Pick one random result: a random page, then a random image path from it.
fetch_url() {
    local args=(-sG "$API_BASE"
        --data-urlencode "sorting=$SORTING"
        --data-urlencode "page=$(( RANDOM % 20 + 1 ))"
        --data-urlencode "atleast=$RESOLUTION"
        --data-urlencode "ratios=$RATIOS"
        --data-urlencode "purity=$PURITY"
        --data-urlencode "categories=$CATEGORIES")
    if [ -n "$QUERY" ]; then
        args+=(--data-urlencode "q=$QUERY")
    fi
    if [ -n "$API_KEY" ]; then
        args+=(--data-urlencode "apikey=$API_KEY")
    fi
    if [ "$SORTING" = "toplist" ] && [ -n "$TOPRANGE" ]; then
        args+=(--data-urlencode "topRange=$TOPRANGE")
    fi

    local json
    json="$(curl -fsS "${args[@]}")" || die "Wallhaven request failed"
    grep -q '"data"' <<<"$json" || die "unexpected response from $API_BASE"

    local paths urls=()
    paths="$(grep -oP '"path":\s*"\K[^"]+' <<<"$json" | tr -d '\\' || true)"
    [ -n "$paths" ] || die "no wallpapers matched the current filters"
    while IFS= read -r line; do
        [ -n "$line" ] && urls+=("$line")
    done <<<"$paths"

    printf '%s\n' "${urls[RANDOM % ${#urls[@]}]}"
}

# Download one image into $WALLHAVEN_DIR and print the local path.
download() {
    local url="$1"
    local file="$WALLHAVEN_DIR/$(basename "$url")"

    if [ -f "$file" ]; then
        echo "Already downloaded: $(basename "$file")" >&2
        printf '%s\n' "$file"
        return 0
    fi

    echo "Downloading $(basename "$file") ..." >&2
    if ! curl -fsSL -o "$file" "$url"; then
        rm -f "$file"
        die "download failed: $url"
    fi
    printf '%s\n' "$file"
}

cmd_new() {
    command -v curl >/dev/null 2>&1 || die "curl is not installed"
    command -v caelestia >/dev/null 2>&1 || die "caelestia is not installed"
    mkdir -p "$WALLHAVEN_DIR"

    local url file
    url="$(fetch_url)" || exit 1
    file="$(download "$url")" || exit 1

    caelestia wallpaper -f "$file"
    echo "Wallpaper applied: $file"
}

case "${1:-help}" in
    new) cmd_new ;;
    help | -h | --help) usage ;;
    *)
        echo "Unknown command: $1" >&2
        usage >&2
        exit 1
        ;;
esac

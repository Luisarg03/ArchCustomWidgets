# Sensitive — live firewall rules (network topology), not for public repos
services/vpn-surfshark/src/nftables.conf

# Local user data / state files (never publish)
**/tasks.txt
**/countdowns.txt
**/.state
**/.current_style_index

# Backups of user files created by install.sh
*.bak-*

# Local user notes store (created at runtime by task-notes)

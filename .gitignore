**/gmail-app-password

# Python bytecode from the unit helpers
__pycache__/
*.pyc

# Local tooling & work-in-progress specs (keep openspec/specs/ canonical)
.opencode/
openspec/changes/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~
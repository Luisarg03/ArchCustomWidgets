// Template fragment for the waybar-todo unit.
// This is a TEMPLATE, not an auto-applied config. Merge it into your waybar
// config (~/.config/waybar/config.jsonc) and add "custom/todo" to one of the
// module arrays (modules-left / modules-center / modules-right).
// Adjust the paths if you installed to a different INSTALL_ROOT.
"custom/todo": {
    "exec": "~/.config/acw/waybar-todo/src/todo.sh",
    "interval": 5,
    "tooltip": true,
    "on-click": "~/.config/acw/waybar-todo/src/todo.sh mark_done",
    "on-click-right": "~/.config/acw/waybar-todo/src/todo.sh open_tui",
    "on-click-middle": "~/.config/acw/waybar-todo/src/todo.sh middle_click"
}

// Template fragment for the waybar-countdown unit.
// This is a TEMPLATE, not an auto-applied config. Merge it into your waybar
// config (~/.config/waybar/config.jsonc) and add "custom/countdown" to one of
// the module arrays (modules-left / modules-center / modules-right).
// Adjust the paths if you installed to a different INSTALL_ROOT.
"custom/countdown": {
    "exec": "~/.config/acw/waybar-countdown/src/countdown.sh",
    "interval": 3600,
    "tooltip": true,
    "on-click-right": "~/.config/acw/waybar-countdown/src/countdown.sh interactive",
    "on-scroll-up": "~/.config/acw/waybar-countdown/src/countdown.sh scroll-up",
    "on-scroll-down": "~/.config/acw/waybar-countdown/src/countdown.sh scroll-down"
}
